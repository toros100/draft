import { Slider, Button } from "std-widgets.slint";

// Option<ObjectId> in rust
export struct OptionObjId {raw: int}

// ObjectId in rust
export struct ObjId {raw: int}

export global Id {
    out property <OptionObjId> NONE: { raw: -1 };

    public pure function eq(a: OptionObjId, b: ObjId) -> bool {
        a.raw == b.raw
    }

    public pure function fmt(a: OptionObjId) -> string {
        if a == NONE {
            "none"
        } else {
            "\{a.raw}"
        }
    }
}

export struct ToolData {
    name: string,
}

export struct WorldPos {
    x: float,
    y: float,
}


component CustomButton inherits Rectangle {
    callback clicked;

    in property <string> text;
    in property <bool> selected;

    background: selected ? #033333 : #111111;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? #accccc : #888888;
    touch := TouchArea {
        clicked => { clicked() }
        mouse-cursor: touch.has-hover ? MouseCursor.pointer : MouseCursor.default;
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: text;
            }
        }
    }
}


export component MainWindow inherits Window {
    callback pointer_event(kind: PointerEventKind, button: PointerEventButton, x: float, y: float);
    callback tool_choice(idx: int);

    in-out property <OptionObjId> hover_id: Id.NONE;
    property <float> scale_val: 1;

    in property <[ToolData]> tools;
    in-out property <int> selected_tool: 0;

    in-out property <image> canvas;
    out property <length> canvas_width: canvas.width;
    out property <length> canvas_height: canvas.height;
    in property <bool> panning;
    in property <WorldPos> world_pos;

    preferred-width: 1200px;
    preferred-height: 800px;

    pure function fmt_float(f: float) -> float {
        (f * 100).round() / 100
    }

    VerticalLayout {

        HorizontalLayout {
            spacing: 4px;
            padding: 4px;
            height: 36px;
            for tool[i] in tools: CustomButton {
                text: tool.name;
                selected: i == root.selected_tool ? true : false;
                clicked => {
                    root.selected_tool = i;
                    root.tool_choice(i);
                }
            }
            Rectangle { }
        }

        Rectangle {
            canvas := Image {
                image-fit: fill;
                width: 100%;
                height: 100%;

                source: root.canvas;
                touch := TouchArea {

                    mouse-cursor: root.panning ? MouseCursor.grabbing : MouseCursor.default;

                    pointer-event(event) => {
                        root.pointer_event(event.kind, event.button, self.mouse_x / 1px, self.mouse_y / 1px)
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            HorizontalLayout {
                alignment: start;
                padding: 8px;
                spacing: 8px;
                Slider {
                    preferred-width: 100px;
                    minimum: 0.25;
                    maximum: 50;
                    value <=> scale_val;
                }

                Text {
                    text: "cursor at: (\{fmt_float(root.world_pos.x)}, \{fmt_float(root.world_pos.y)})";
                }

                Text {
                    text: "hover?: \{Id.fmt(root.hover_id)}";
                }

                Rectangle { }
            }
        }
    }
}
